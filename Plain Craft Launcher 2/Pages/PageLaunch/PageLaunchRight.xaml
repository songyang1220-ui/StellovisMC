<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="28,28,28,16" Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanWelcome">
                <local:MyCard Margin="0,0,0,20" HasMouseAnimation="False"
                              BackgroundBrush="{DynamicResource StellovisHeroBrush}">
                    <Grid Margin="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="138" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="STELLOVISMC" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource StellovisHeroSubtextBrush}" />
                            <TextBlock Text="{loc:Loc Stellovis.Home.Title}" FontSize="29" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextTrimming="None" LineHeight="39" Margin="0,12,0,12"
                                       Foreground="{DynamicResource StellovisHeroTextBrush}" />
                            <TextBlock Text="{loc:Loc Stellovis.Home.Description}" FontSize="13" LineHeight="22"
                                       TextWrapping="Wrap" TextTrimming="None"
                                       Foreground="{DynamicResource StellovisHeroSubtextBrush}" />
                            <WrapPanel Margin="0,24,0,0">
                                <local:MyButton Text="{loc:Loc Stellovis.Home.SelectInstance}" ColorType="Highlight"
                                                Width="126" Height="42" Margin="0,0,10,6"
                                                Tag="Instances" Click="WelcomeAction_Click" />
                                <local:MyButton Text="{loc:Loc Stellovis.Home.Install}" Width="126" Height="42"
                                                Margin="0,0,0,6" Tag="Download" Click="WelcomeAction_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <Image Grid.Column="1" Source="/StellovisMC;component/Images/icon.png"
                               Width="128" Height="128" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                    </Grid>
                </local:MyCard>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:MyCard Title="{loc:Loc Stellovis.Home.Discover.Title}" Margin="0,0,8,0">
                        <StackPanel Margin="20,44,20,20">
                            <TextBlock Text="{loc:Loc Stellovis.Home.Discover.Description}" TextWrapping="Wrap"
                                       TextTrimming="None" LineHeight="22" MinHeight="44"
                                       Foreground="{DynamicResource StellovisMutedTextBrush}" />
                            <local:MyButton Text="{loc:Loc Stellovis.Home.Discover.Action}" Height="38"
                                            Margin="0,18,0,0" Tag="Download" Click="WelcomeAction_Click" />
                        </StackPanel>
                    </local:MyCard>
                    <local:MyCard Grid.Column="1" Title="{loc:Loc Stellovis.Home.Settings.Title}" Margin="8,0,0,0">
                        <StackPanel Margin="20,44,20,20">
                            <TextBlock Text="{loc:Loc Stellovis.Home.Settings.Description}" TextWrapping="Wrap"
                                       TextTrimming="None" LineHeight="22" MinHeight="44"
                                       Foreground="{DynamicResource StellovisMutedTextBrush}" />
                            <local:MyButton Text="{loc:Loc Stellovis.Home.Settings.Action}" Height="38"
                                            Margin="0,18,0,0" Tag="Settings" Click="WelcomeAction_Click" />
                        </StackPanel>
                    </local:MyCard>
                </Grid>
                <TextBlock Text="StellovisMC · Minecraft Java Edition" FontSize="11" Margin="2,0,0,10"
                           Foreground="{DynamicResource StellovisMutedTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="PanCustom" />
            <local:MyCard Margin="0,0,0,15" Title="{loc:Loc Launch.Right.Log.Title}"
                          x:Name="PanLog">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
